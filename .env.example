# ---------------------------------------------------------------------------
# Firebase configuration
# Copy this file to `.env.local` and fill in the values from your Firebase
# project: https://console.firebase.google.com
#
# Project settings -> General -> Your apps -> Web app -> SDK setup and config
# ---------------------------------------------------------------------------

# Public Web App API key (safe to expose in a browser application)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourApiKeyHere

# Project identifier (e.g. "retail-pos-12345")
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=retail-pos.firebaseapp.com

# Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=retail-inventory-pos

# Storage bucket
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=retail-inventory-pos.appspot.com

# Messaging sender ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890

# Web app ID
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ---------------------------------------------------------------------------
# The values below are OPTIONAL. Only required if you enable Google
# Analytics or Firebase Emulator usage during local development.
# ---------------------------------------------------------------------------

# Measurement ID
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-12345

# When set to "true", all Firestore/Auth SDK calls are routed to the local
# Firebase Emulator suite (useful for offline development & demos).
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false